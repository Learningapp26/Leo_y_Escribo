# Copia este archivo a .env.local (ignorado por git) para activarlo.

# true  -> login/signup usan localStorage (mockAuth.js), sin Supabase real.
# false -> login/signup usan Supabase Auth (requiere que el proyecto exista).
VITE_USE_MOCK_AUTH=false

# URL del módulo de Matemática (repo frontend_math). El botón «Matemáticas»
# de /welcome y el panel docente mandan ahí con la sesión en el hash.
# En local, el puerto fijo de frontend_math.
VITE_MATE_URL=http://localhost:5174
