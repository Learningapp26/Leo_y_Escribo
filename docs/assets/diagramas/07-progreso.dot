digraph {
  graph [rankdir=TB]
  graph [bgcolor="#FFFFFF", pad="0.18", ranksep="0.35", nodesep="0.30", dpi=185]
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, color="#737E9E", fontcolor="#25345A", penwidth=1.2, fillcolor="#F5F7FB", margin="0.18,0.11"]
  edge [color="#626C87", fontcolor="#334267", fontname="Arial", fontsize=11, arrowsize=0.7]
  intento [label="Intento o final de lección",fillcolor="#E8EDFA"]
  usuario [label="Auth: usuario actual"]
  aula [label="Resolver código de aula\ny asegurar fila de estudiante"]
  evento [label="Insertar evento en progreso\nmodulo = comunicacion"]
  resumen [label="Leer y agregar eventos\nEstrellas, racha y completadas"]
  salida [label="Inicio, desbloqueos, Mi viaje y sellos",fillcolor="#E1F3EB"]
  intento -> usuario -> aula -> evento -> resumen -> salida
}
